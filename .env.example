# ── Free-tier AI providers (configure one or more) ───────────────────────────
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cloudflare Workers AI: create an API token and copy your account ID
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Provider priority. The router automatically tries the next configured provider
# when a provider is unavailable, rate-limited, or its model cannot be accessed.
AI_PROVIDER_ORDER=groq,cloudflare,gemini

# Optional per-model overrides. Examples:
# GEMINI_MODEL_NAMELESS_AI=gemini-2.5-flash-lite
# GROQ_MODEL_NAMELESS_AI=openai/gpt-oss-20b
# CLOUDFLARE_MODEL_NAMELESS_AI=@cf/openai/gpt-oss-20b
# MAX_TOKENS=1536

# ── Supabase Auth + cloud chat sync ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://nzaelikbjumaidaombmp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Optional: live web search tool ──────────────────────────────────────────
TAVILY_API_KEY=

# ── Optional: email sending from the AI ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
