# ── Required AI provider: Google Gemini (no OpenRouter) ─────────────────────
# Create a key at https://aistudio.google.com/apikey
# Locally: copy this file to .env.local. On Vercel: Project → Settings →
# Environment Variables → add GEMINI_API_KEY, then redeploy.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase Auth (Google / GitHub / Email) + cloud chat sync ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://nzaelikbjumaidaombmp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Optional: override a Gemini model for a Nameless Labs tier ──────────────
# Pattern: GEMINI_MODEL_<TIER_ID_UPPERCASE_WITH_UNDERSCORES>
# GEMINI_MODEL_NAMELESS_AI=gemini-3.8-flash
# GEMINI_MODEL_PULSE_NANO=gemini-3.5-flash-lite
# GEMINI_MODEL_LYRIC_FLASH=gemini-3.8-flash
# GEMINI_MODEL_VEGA_MINI=gemini-3.8-flash
# GEMINI_MODEL_AETHER_PRO=gemini-3.1-pro-preview
# GEMINI_MODEL_QUASAR_APEX=gemini-3.1-pro-preview
# MAX_TOKENS=2048

# ── Optional: live web search tool ─────────────────────────────────────────
# Without this key, web_search is not offered; other built-in tools still work.
TAVILY_API_KEY=

# ── Optional: email sending from the AI ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
