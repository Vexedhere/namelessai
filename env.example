# ── Required ────────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
# Locally: copy this file to .env.local.  On Vercel: Project → Settings →
# Environment Variables → add OPENROUTER_API_KEY, then redeploy.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Supabase Auth (Google / GitHub / Email) + cloud chat sync ───────────────
# Project nzaelikbjumaidaombmp. Get the key at: Supabase → Project Settings → API
# → "anon" / "publishable" key (safe to expose; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://nzaelikbjumaidaombmp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Optional: your own fine-tuned NamelessAI endpoint ───────────────────────
# If set, the "NamelessAI (Custom Fine-Tuned)" tier calls this first and falls
# back to OpenRouter (Qwen 2.5 72B) if it fails.
CUSTOM_MODEL_URL=
CUSTOM_MODEL_TOKEN=

# ── Optional: override any tier's OpenRouter model slug (no code change) ────
# Pattern: MODEL_<TIER_ID_UPPERCASE_WITH_UNDERSCORES>
# MODEL_NAMELESS_AI=qwen/qwen-2.5-72b-instruct
# MODEL_PULSE_NANO=meta-llama/llama-3.2-3b-instruct
# MODEL_LYRIC_FLASH=google/gemini-2.5-flash
# MODEL_VEGA_MINI=openai/gpt-4o-mini
# MODEL_AETHER_PRO=anthropic/claude-sonnet-5.5
# MODEL_QUASAR_APEX=deepseek/deepseek-r1-0528

# ── Optional ────────────────────────────────────────────────────────────────
# Max tokens per reply (lower = cheaper, avoids "insufficient credits" errors)
# MAX_TOKENS=4096
# Public URL sent to OpenRouter as the HTTP-Referer (defaults to your Vercel URL)
# SITE_URL=https://your-domain.com

# Server-only Supabase service role key (required to read subscription tiers securely)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Optional: email sending from the AI ("email Rahul about…") ───────────────
# Uses Resend (https://resend.com). EMAIL_FROM must be on a domain you verified there,
# e.g. "Nameless Labs AI <assistant@yourdomain.com>". Without these two, the email card
# still works: it falls back to "Open in mail app" (a pre-filled mailto: draft).
# Only signed-in users can send, max 10 emails/hour/user; replies go to the user's own address.
RESEND_API_KEY=
EMAIL_FROM=

# ── Optional: full web search for the agent (pick one; without it web_search falls back to Wikipedia) ──
# TAVILY_API_KEY=
# BRAVE_API_KEY=
